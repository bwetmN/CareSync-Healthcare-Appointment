// PostgreSQL Prisma Schema for CareSync Platform
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String          @id @default(uuid())
  email              String          @unique
  passwordHash       String
  name               String
  role               String          @default("PATIENT")
  phone              String?
  googleRefreshToken String?
  appointments       Appointment[]   @relation("PatientAppointments")
  prescriptions      Prescription[]  @relation("PatientPrescriptions")
  slotHolds          SlotHold[]      @relation("PatientHolds")
  doctorProfile      DoctorProfile?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
}

model DoctorProfile {
  id                    String         @id @default(uuid())
  userId                String         @unique
  user                  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  specialization        String
  consultationFee       Float
  slotDurationMinutes   Int            @default(30)
  workingStartTime      String         @default("09:00")
  workingEndTime        String         @default("17:00")
  appointments          Appointment[]  @relation("DoctorAppointments")
  leaves                DoctorLeave[]
  slotHolds             SlotHold[]     @relation("DoctorHolds")
  prescriptions         Prescription[] @relation("DoctorPrescriptions")
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
}

model DoctorLeave {
  id        String        @id @default(uuid())
  doctorId  String
  doctor    DoctorProfile @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  leaveDate String        // YYYY-MM-DD
  reason    String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@unique([doctorId, leaveDate])
}

model SlotHold {
  id          String        @id @default(uuid())
  doctorId    String
  doctor      DoctorProfile @relation("DoctorHolds", fields: [doctorId], references: [id], onDelete: Cascade)
  patientId   String
  patient     User          @relation("PatientHolds", fields: [patientId], references: [id], onDelete: Cascade)
  slotDate    String        // YYYY-MM-DD
  startTime   String        // HH:MM
  holdToken   String        @unique
  expiresAt   DateTime
  status      String        @default("HELD") // HELD, CONVERTED, RELEASED
  createdAt   DateTime      @default(now())

  @@index([doctorId, slotDate, startTime])
  @@index([expiresAt])
}

model Appointment {
  id                    String         @id @default(uuid())
  patientId             String
  patient               User           @relation("PatientAppointments", fields: [patientId], references: [id], onDelete: Cascade)
  doctorId              String
  doctor                DoctorProfile  @relation("DoctorAppointments", fields: [doctorId], references: [id], onDelete: Cascade)
  appointmentDate       String         // YYYY-MM-DD
  startTime             String         // HH:MM
  status                String         @default("BOOKED") // BOOKED, COMPLETED, CANCELLED, LEAVE_CONFLICT
  symptoms              String
  preVisitUrgency       String         @default("Low") // Low, Medium, High
  preVisitSummary       String?
  preVisitQuestions     String?        // Serialized JSON array of strings
  postVisitNotes        String?
  postVisitSummary      String?        // AI generated summary of the visit
  googleCalendarEventId String?
  prescriptions         Prescription[]
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  @@unique([doctorId, appointmentDate, startTime, status])
}

model Prescription {
  id                    String                  @id @default(uuid())
  appointmentId         String
  appointment           Appointment             @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  patientId             String
  patient               User                    @relation("PatientPrescriptions", fields: [patientId], references: [id], onDelete: Cascade)
  doctorId              String
  doctor                DoctorProfile           @relation("DoctorPrescriptions", fields: [doctorId], references: [id], onDelete: Cascade)
  medicationName        String
  dosage                String                  // e.g. "500mg"
  frequency             String                  // e.g. "ONCE_DAILY", "TWICE_DAILY", "THRICE_DAILY"
  durationDays          Int
  startDate             String                  // YYYY-MM-DD
  reminders             MedicationReminderLog[]
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
}

model MedicationReminderLog {
  id             String       @id @default(uuid())
  prescriptionId String
  prescription   Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  scheduledTime  DateTime
  sentTime       DateTime?
  status         String       @default("PENDING") // PENDING, SENT, FAILED
  errorLog       String?
  createdAt      DateTime     @default(now())
}

model EmailOutbox {
  id             String    @id @default(uuid())
  to             String
  subject        String
  body           String    // HTML body
  status         String    @default("PENDING") // PENDING, SENT, FAILED
  attempts       Int       @default(0)
  lastAttempt    DateTime?
  nextAttempt    DateTime  @default(now())
  errorLog       String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}
