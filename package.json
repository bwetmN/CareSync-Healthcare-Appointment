{
  "name": "healthcare-manager-root",
  "version": "1.0.0",
  "type": "module",
  "description": "Healthcare Appointment & Follow-up Manager - Full Stack Platform",
  "private": true,
  "scripts": {
    "dev:server": "cd server && npm run dev",
    "dev:client": "cd client && npm run dev",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "build:server": "cd server && npm run build",
    "build:client": "cd client && npm run build",
    "build": "npm run build:server && npm run build:client",
    "seed": "cd server && npm run seed",
    "test": "cd server && npm test",
    "test:concurrency": "cd server && npm run test:concurrency",
    "package:zip": "node scripts/build-zip.js"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "keywords": [
    "healthcare",
    "appointment-manager",
    "gemini-ai",
    "bullmq",
    "prisma",
    "postgresql",
    "react",
    "google-calendar"
  ],
  "author": "Aryan",
  "license": "MIT"
}
